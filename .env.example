# Variables optionnelles du front (Vite). Copier en .env.local pour le développement,
# ou les définir dans Vercel > Project > Settings > Environment Variables.
# Toutes ces valeurs sont publiques (exposées dans le navigateur) : n'y mettez jamais de secret.

# URL et clé publishable Supabase (valeurs par défaut déjà présentes dans src/config.js)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clé de SITE Cloudflare Turnstile (anti-robot). Laisser vide pour désactiver le widget.
# La clé SECRÈTE correspondante se configure côté Supabase : TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=
